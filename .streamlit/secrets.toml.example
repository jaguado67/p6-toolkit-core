# Copy to .streamlit/secrets.toml (same folder) and replace the hashes.
# Generate each hash with:   py -m p6toolkit hash-password
# NEVER commit or share secrets.toml.

[auth]
enabled = true

[auth.users.jaguado]
name = "Jair Aguado"
password = "pbkdf2_sha256$600000$REPLACE$REPLACE"

[auth.users.planner1]
name = "Planner 1"
password = "pbkdf2_sha256$600000$REPLACE$REPLACE"
# disabled = true      # uncomment to revoke access without deleting the user
